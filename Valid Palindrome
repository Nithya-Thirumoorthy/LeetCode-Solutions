class Solution {
    public boolean isPalindrome(String s) {
        char[] arr = new char[s.length()];
        int j = 0;
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if ((ch >= 'a' && ch <= 'z') ||
                (ch >= 'A' && ch <= 'Z') ||
                (ch >= '0' && ch <= '9')) {
                ch = Character.toLowerCase(ch);
                arr[j] = ch;
                j++;
            }
        }
        char[] reverse = new char[j];
        for (int i = 0; i < j; i++) {
            reverse[i] = arr[j - 1 - i];
        }
        for (int i = 0; i < j; i++) {
            if (arr[i] != reverse[i]) {
                return false;
            }
        }
        return true;
    }
}
