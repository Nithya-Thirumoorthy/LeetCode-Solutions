class Solution {
    public int[] sortedSquares(int[] nums) {
        int len=nums.length;
        for(int i=0;i<len;i++)
        {
            int k=nums[i];
            int a=Math.abs(k);
            int squared=a*a;
            nums[i]=squared;
        }
        Arrays.sort(nums);
        return nums;
    }
}
