class Solution {
    public void rotate(int[] nums, int k) {

        int n = nums.length;
        int[] temp = new int[n];

        k = k % n;

        for (int i = 0; i < n; i++) {

            if (i + k < n) {
                temp[i + k] = nums[i];
            } else {
                temp[i + k - n] = nums[i];
            }
        }

        for (int i = 0; i < n; i++) {
            nums[i] = temp[i];
        }
    }
}
