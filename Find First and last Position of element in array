class Solution {
    public int[] searchRange(int[] nums, int target) {
        int count=0;
        int[] arr={-1,-1};
        int j=0;
        for(int i=0;i<nums.length;i++)
        {
            if(nums[i]!=target)
            {
                count++;
            }
        }
        if(count == nums.length)
        {
            return arr;
        }
        int len=nums.length;
        int newarr=len-count;
        int[] op=new int[2];
        for(int i=0;i<nums.length;i++)
        {
            if(nums[i]==target)
            {
                if(j==0)
                {
                    op[0]=i;
                }
                op[1]=i;
                j++;
            }
        }
        return op;
        
    }
}
