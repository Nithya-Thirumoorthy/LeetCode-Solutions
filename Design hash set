class MyHashSet {
    ArrayList<Integer> arr;

    public MyHashSet() {
        arr=new ArrayList<>();
        
    }
    
    public void add(int key) {
        if(!contains(key))
        {
            arr.add(key);
        }
        
    }
    
    public void remove(int key) {
        if(contains(key))
        {
            arr.remove(Integer.valueOf(key));
        }
        
    }
    
    public boolean contains(int key) {
        if(arr.contains(key))
        {
            return true;
        }
        else
        {
            return false;
        }
        
    }
}
