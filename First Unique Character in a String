class Solution {
    public int firstUniqChar(String s) {
        int len=s.length();
        char f;
        for(int i=0;i<len;i++)
        {
            f=s.charAt(i);
            if (s.indexOf(f) == s.lastIndexOf(f))
            {
                return i;
            }
        }
        return -1;
    }
}
