class MinStack {
    Stack<Integer> s;
    Stack<Integer> minStack;


    public MinStack() {
        s=new Stack<>();
        minStack=new Stack<>();
        
    }
    
    public void push(int value) {
        s.push(value);
        if (minStack.isEmpty() || value <= minStack.peek()) 
        {
            minStack.push(value);
        }
        
    }
    
    public void pop() {
        if (s.peek().equals(minStack.peek())) 
        {
            minStack.pop();
        }
        s.pop();
        
    }
    
    public int top() {
        int num=s.peek();
        return num;
        
    }
    
    public int getMin() {
        int num=minStack.peek();
        return num;
        
    }
}

