class MyQueue {
    Queue<Integer> q;

    public MyQueue() {
        q=new LinkedList<>();
    }
    
    public void push(int x) {
        q.offer(x);
        
    }
    
    public int pop() {
        return q.poll();
        
    }
    
    public int peek() {
        return q.peek();
        
    }
    
    public boolean empty() {
        if(q.isEmpty())
        {
            return true;
        }
        else
        {
            return false;
        }
        
    }
}

