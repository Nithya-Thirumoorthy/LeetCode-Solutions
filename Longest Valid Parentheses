class Solution {
    public int longestValidParentheses(String s) {
        Stack<Integer> n=new Stack<>();
        int max=0;
        if(s == null || s.length() == 0)
        {
            return 0;
        }
        n.push(-1);
        for(int i=0;i<s.length();i++)
        {
            if(s.charAt(i) == '(')
            {
                n.push(i);
            }
            else
            {
                n.pop();
                if(n.isEmpty())
                {
                    n.push(i);
                }
                else
                {
                    int length=i-n.peek();
                    if (length > max) 
                    {
                        max = length;
                    }
                }
            }
        }
        return max;
    }
}
